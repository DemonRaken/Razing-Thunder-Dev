    l "¿Sabés a qué hora se reportó el cuerpo?"

# game/act3.rpy:1320
translate spanish bigCE_Renata_ba204c6a:

    # r "Like I said! Sometime around 10:34!"
    r "¡Como ya dije! ¡Tipo 10:34!"

# game/act3.rpy:1321
translate spanish bigCE_Renata_b606eb1b:

    # l "10:42 AM. You're off by eight minutes."
    l "10:42 AM. Te equivocaste por ocho minutos."

# game/act3.rpy:1322
