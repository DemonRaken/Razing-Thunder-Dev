    l "¡Concentrate, yo!"

# game/act3.rpy:1413
translate spanish tr_kick_9235701d:

    # l "If the death blow was a kick to the head, that must have been one hell of a martial artist to pull off such a fatality."
    l "Si el golpe mortal fue una patada en la cabeza, eso debe haber sido un artista marcial de primera para lograr tal fatalidad."

# game/act3.rpy:1414
translate spanish tr_kick_1109763f:

    # l "But this isn't a kung fu movie... think! I know I found a likely murder weapon!"
    l "Pero esto no es una película de kung fu... ¡pensá! ¡Sé que encontré un arma probable del asesinato!"

# game/act3.rpy:1417
translate spanish tr_shovel_d589d688:

    # l "The shovel is the most likely weapon. It has a dent in it, and the victim's blood was found on it."
    l "La pala es el arma más probable. Tiene una abolladura, y se encontró la sangre de la víctima en ella."

# game/act3.rpy:1418
translate spanish tr_shovel_5212b003:

    # l "That means blood must have been left behind at the scene."
    l "Eso significa que debe haber quedado sangre en la escena."

# game/act3.rpy:1423
translate spanish call4help_618f70a0:

    # l "After killing Vicente, the culprit..."
    l "Después de matar a Vicente, el culpable..."

