    l "E-ey, esperá un momento-"

# game/act3.rpy:2065
translate spanish choose_med_a63836f5:

    # me "First off, I have an alibi! I've been busting my ass investigating this place!"
    me "¡Primero, tengo una coartada! ¡Me estoy rompiendo el culo investigando este lugar!"

# game/act3.rpy:2067
translate spanish choose_med_d4bb94ca:

    # me "Second, I have absolutely no motive to attack that man!"
    me "¡Segundo, no tengo absolutamente ningún motivo para atacar a ese tipo!"

