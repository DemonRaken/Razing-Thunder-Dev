    tt closed neutral "Juego clandestino…"

# game/act2.rpy:647
translate spanish stables1_topic1_2d2bcab7:

    # t neutral "Do you know which jockeys are sponsored by the Castillos?"
    t neutral "¿Sabés qué jockeys están patrocinados por los Castillo?"

# game/act2.rpy:650
translate spanish stables1_topic1_7d740d76:

    # c "I don't bother remembering the fodder."
    c "No me tomo el trabajo de acordarme de la yapa."

# game/act2.rpy:652
translate spanish stables1_topic1_3b206a97:

    # tt what drop "That's brutal…"
    tt what drop "Qué brutal…"

# game/act2.rpy:654
translate spanish stables1_topic1_7d4a74cd:

    # c "One does come to mind, though. Vargas. She's their top pick for promotion. Renata Vargas."
    c "Una me acuerdo, igual. Vargas. Es su carta más fuerte para promocionar. Renata Vargas."

# game/act2.rpy:656
translate spanish stables1_topic1_d6e21214:

    # t neutral "Interesting…"
    t neutral "Interesante…"

# game/act2.rpy:659
translate spanish stables1_topic2_62666008:

    # t neutral drop "I, uh… I heard some unsavory rumors going around."
    t neutral drop "Yo, eh… Escuché unos rumores medio turbios dando vueltas."

# game/act2.rpy:661
translate spanish stables1_topic2_6e6ce20e:

    # c "Oh?"
    c "¿Ah?"

# game/act2.rpy:663
translate spanish stables1_topic2_676d021f:

    # t neutral right "From the other jockeys, I mean. Mostly about you."
    t neutral right "De los otros jockeys, digo. Principalmente sobre vos."

# game/act2.rpy:665
translate spanish stables1_topic2_173ef9d7:

    # c "I see. And?"
    c "Ya veo. ¿Y?"

# game/act2.rpy:667
translate spanish stables1_topic2_8555b7a6:

    # t det yell "What do you mean, 'and'!? Don't you care about being slandered? They're saying you're using your money to bribe trainers into quitting. Some even claim you're behind the horses collapsing."
    t det yell "¿Cómo que '¿y?'!? ¿No te importa que te calumnien? Dicen que usás tu plata para sobornar a los entrenadores para que renuncien. Algunos hasta dicen que vos estás detrás de que los caballos se desplomen."

# game/act2.rpy:670
translate spanish stables1_topic2_69d8ce9b:

    # c "I have an inkling of who told you about that last one. It's not the first time I've heard those accusations from the likes of her."
